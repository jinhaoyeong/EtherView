# Copy to .env.local. Never commit real keys.
# Optional preferred history provider. Public Blockscout history is used without a key
# and when Etherscan is unavailable; the fallback is limited to recent transfers.
ETHERSCAN_API_KEY=

# Optional: authenticated RPC and broader token discovery.
ALCHEMY_API_KEY=
COVALENT_API_KEY=
ZAPPER_API_KEY=

# Optional market/news sources. Public fallbacks have limits.
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
CRYPTOCOMPARE_API_KEY=
NEWSAPI_API_KEY=
CURRENTS_API_KEY=

# Optional existing sentiment providers; heuristics are used without them.
GLM_API_KEY=
GLM_BASE_URL=
OPENAI_API_KEY=
